{
  "name": "grokbot-persona-database",
  "version": "1.2.0",
  "description": "System prompts for Grok, including a desk of business operators.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-personas.mjs",
    "index": "node scripts/index-catalog.mjs",
    "build:personas": "node scripts/write-personas.mjs && node scripts/index-catalog.mjs",
    "test": "npm run validate"
  },
  "keywords": [
    "grok",
    "grokbot",
    "persona",
    "llm",
    "system-prompt",
    "prompt-library"
  ],
  "files": [
    "personas",
    "schemas",
    "examples",
    "templates",
    "docs",
    "web",
    "catalog.json"
  ],
  "devDependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.1"
  }
}
