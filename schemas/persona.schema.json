{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sullyvickers1/grokbot-persona-database/main/schemas/persona.schema.json",
  "$comment": "Grokbot Persona Database schema v1.1.0 — source of truth for every persona file.",
  "title": "Grokbot Persona",
  "description": "A versioned, reusable LLM persona: identity, system prompt, speaking contract, and worked examples.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "slug",
    "version",
    "last_updated",
    "status",
    "category",
    "subcategory",
    "tags",
    "short_description",
    "description",
    "system_prompt",
    "personality_traits",
    "speaking_style",
    "knowledge_domains",
    "response_guidelines",
    "example_interactions",
    "recommended_use_cases",
    "anti_use_cases",
    "compatibility",
    "author",
    "license"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1.0",
      "description": "Must match the current schema release. Bump only via a schema PR."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64,
      "description": "Stable kebab-case identifier. Never rename after publish; add a successor instead."
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "description": "Display name as the model should identify itself."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Must equal id. Duplicated so catalogs can treat slug as a public URL key."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "Semver of this persona file. MAJOR = behavior break, MINOR = new capability, PATCH = copy edit."
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date (YYYY-MM-DD) of the last meaningful edit."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "stable", "deprecated"],
      "description": "draft = not yet curated; stable = safe to depend on; deprecated = use successor_id."
    },
    "successor_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Required when status is deprecated."
    },
    "category": {
      "type": "string",
      "enum": [
        "professional",
        "creative",
        "personality",
        "specialized",
        "experimental"
      ],
      "description": "Top-level collection. Must match the parent folder name."
    },
    "subcategory": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "description": "Finer label inside the category (e.g. 'law', 'systems', 'voice')."
    },
    "tags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "minLength": 2,
        "maxLength": 32
      }
    },
    "short_description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 160,
      "description": "One-line catalog blurb. No marketing adjectives."
    },
    "description": {
      "type": "string",
      "minLength": 160,
      "maxLength": 900,
      "description": "What this persona is for, how it thinks, and when to pick it over a neighbor."
    },
    "system_prompt": {
      "type": "string",
      "minLength": 1200,
      "maxLength": 12000,
      "description": "The full system prompt. Must include identity, thinking process, speech contract, output contract, and hard rules."
    },
    "personality_traits": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trait", "intensity", "notes"],
        "properties": {
          "trait": { "type": "string", "minLength": 2, "maxLength": 40 },
          "intensity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1 = faint, 5 = defining. At most two traits may be 5."
          },
          "notes": { "type": "string", "minLength": 20, "maxLength": 240 }
        }
      }
    },
    "speaking_style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tone",
        "register",
        "sentence_shape",
        "vocabulary",
        "humor",
        "do",
        "dont"
      ],
      "properties": {
        "tone": { "type": "string", "minLength": 8, "maxLength": 160 },
        "register": {
          "type": "string",
          "enum": [
            "formal",
            "neutral",
            "informal",
            "literary",
            "technical",
            "theatrical",
            "spoken"
          ]
        },
        "sentence_shape": { "type": "string", "minLength": 20, "maxLength": 240 },
        "vocabulary": { "type": "string", "minLength": 20, "maxLength": 240 },
        "humor": { "type": "string", "minLength": 8, "maxLength": 200 },
        "do": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 12, "maxLength": 180 }
        },
        "dont": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 12, "maxLength": 180 }
        }
      }
    },
    "knowledge_domains": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "depth"],
        "properties": {
          "domain": { "type": "string", "minLength": 2, "maxLength": 60 },
          "depth": {
            "type": "string",
            "enum": ["foundational", "working", "expert", "specialist"]
          },
          "notes": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "response_guidelines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "must", "must_not", "when_uncertain"],
      "properties": {
        "structure": { "type": "string", "minLength": 40, "maxLength": 400 },
        "must": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 16, "maxLength": 220 }
        },
        "must_not": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 16, "maxLength": 220 }
        },
        "when_uncertain": { "type": "string", "minLength": 24, "maxLength": 320 },
        "safety": { "type": "string", "minLength": 24, "maxLength": 320 }
      }
    },
    "example_interactions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "description": "At least three worked exchanges covering different situations.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "user", "assistant"],
        "properties": {
          "title": { "type": "string", "minLength": 4, "maxLength": 80 },
          "user": { "type": "string", "minLength": 12, "maxLength": 600 },
          "assistant": { "type": "string", "minLength": 80, "maxLength": 2500 },
          "notes": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "recommended_use_cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 12, "maxLength": 160 }
    },
    "anti_use_cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 12, "maxLength": 160 }
    },
    "related_personas": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Neighbor personas a user might confuse this with. Used for disambiguation, not SEO."
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models", "recommended_temperature", "recommended_max_tokens"],
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "recommended_temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5
        },
        "recommended_max_tokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 16384
        },
        "notes": { "type": "string", "maxLength": 200 }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 4, "maxLength": 200 }
    },
    "author": { "type": "string", "minLength": 2, "maxLength": 80 },
    "license": { "type": "string", "const": "MIT" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "deprecated" } },
        "required": ["status"]
      },
      "then": { "required": ["successor_id"] }
    }
  ]
}
