{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sullyvickers1/grokbot-persona-database/main/schemas/catalog.schema.json",
  "title": "Grokbot Persona Catalog Index",
  "description": "Machine-readable index of every stable persona. Generated by scripts/index-catalog.mjs — do not hand-edit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "schema_version", "count", "categories", "personas"],
  "properties": {
    "generated_at": { "type": "string" },
    "schema_version": { "type": "string" },
    "count": { "type": "integer", "minimum": 1 },
    "categories": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "personas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "subcategory",
          "tags",
          "short_description",
          "path",
          "version",
          "status"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "subcategory": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "short_description": { "type": "string" },
          "path": { "type": "string" },
          "version": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
